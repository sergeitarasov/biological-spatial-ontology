########################################
# REGIONS
# parent IRIs used:
#   BSPO_0000070 anatomical region
#   BSPO_0000071 anterior region
#   BSPO_0000072 posterior region
#   BSPO_0000077 proximal region
#   BSPO_0000078 distal region
#   BSPO_0000079 dorsal region
#   BSPO_0000084 ventral region
#   BSPO_0000055 anterior side  (used in overlaps)
#   BSPO_0000056 posterior side (used in overlaps)
#   BSPO_0000061 proximal side  (used in overlaps)
#   BSPO_0000062 distal side    (used in overlaps)
#   BSPO_0000063 dorsal side    (used in overlaps)
#   BSPO_0000068 ventral side   (used in overlaps)
#   RO_0002131   overlaps
########################################

<http://purl.obolibrary.org/obo/BSPO_0031002>
    a owl:Class ;
    rdfs:label "antero-proximal region"^^xsd:string ;
    oboInOwl:id "BSPO:0031002" ;
    oboInOwl:hasOBONamespace "spatial" ;
    obo:IAO_0000115 "Anatomical region that overlaps the anterior and proximal regions of a body or body part." ;
    oboInOwl:created_by "Sergei Tarasov" ;
    oboInOwl:creation_date "2026-05-12T00:00:00Z"^^xsd:dateTime ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        obo:BSPO_0000070
        [ a owl:Restriction ; owl:onProperty obo:RO_0002131 ; owl:someValuesFrom obo:BSPO_0000055 ]
        [ a owl:Restriction ; owl:onProperty obo:RO_0002131 ; owl:someValuesFrom obo:BSPO_0000061 ] ) ] ;
    rdfs:subClassOf obo:BSPO_0000071 ;
